---
import '../styles/global.css';
import IconSprite from '../components/IconSprite.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'AI、モビリティ、教育。杉浦健太郎のパーソナルポートフォリオサイト。' } = Astro.props;
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/jpeg" href="/images/profile/アイコン.jpg" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<!-- Parisienne(装飾スクリプト体)はglobal.css側で自己ホスト(/fonts/Parisienne-Regular.woff2)
     しているため、Google Fontsからの二重読み込みを避けるためfamily=Parisienneを外している。
     font-weight:800(Shippori Mincho B1)・900(Zen Kaku Gothic New)は使用箇所がないため
     リクエストするウェイトから除外し転送量を削減している(旧index.htmlから踏襲)。 -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Shippori+Mincho+B1:wght@400;600&family=IBM+Plex+Mono:wght@400;500;600&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" />
</head>
<body>
<IconSprite />
<SiteHeader />
<slot />
<SiteFooter />
<script>
import '../scripts/style-hover.js';
</script>
</body>
</html>
