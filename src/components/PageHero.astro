---
// サブページ共通の「パンくず + アイコン + 見出し」ヘッダー。
// WORKS配下・GOAL配下など多数のページで同一構造が繰り返されるため、
// Astro移行にあたってコンポーネント化した(旧index.htmlではページごとに
// ほぼ同一のマークアップがベタ書きされていた)。
// 見出し直下の説明文・タグ等はページごとに微妙にスタイルが異なる(line-height/色/
// u-prettyクラスの有無等)ため、共通化せずデフォルトslotとして各ページ側に委ねている。
// タイトルにはslotを使い、<span class="u-nowrap">等の埋め込みタグをそのまま書ける。
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  crumbs: Crumb[];
  icon: string;
  kicker: string;
}
const { crumbs, icon, kicker } = Astro.props;
---
<div class="c-015">
<div class="u-container" style="padding:36px 56px 56px">
<div class="c-013">
{crumbs.map((c, i) => (
  <>
    {c.href ? <a href={c.href} class="c-031" style-hover="color:#3B82C4">{c.label}</a> : <span class="c-139">{c.label}</span>}
    {i < crumbs.length - 1 && <span>/</span>}
  </>
))}
</div>
<div class="c-085">
<span class="u-pill" style="width:52px;height:52px;flex:none;border:1px solid rgba(59,130,196,.3);background:rgba(59,130,196,.08);display:flex;align-items:center;justify-content:center;color:#3B82C4"><svg width="25" height="25" class="c-003"><use href={'#' + icon}></use></svg></span>
<div>
<div class="c-037">{kicker}</div>
<h1 class="u-fs-42" style="margin:3px 0 0;font-family:'Shippori Mincho B1',serif;font-weight:600;line-height:1.3;letter-spacing:.03em"><slot name="title" /></h1>
</div>
</div>
<slot />
</div>
</div>
