---
// サイト共通ヘッダー。旧index.htmlのdc-runtimeヘッダー(hashルーティング)を
// Astroの実URLルーティングに置き換えたもの。
// アクティブ状態(atProfile等)はクライアントJSではなくAstro.url.pathnameから
// ビルド/リクエスト時に確定させるため、旧実装のようなJSでのstate管理は不要。
const path = Astro.url.pathname;
const atProfile = path.startsWith('/profile');
const atWorks = path.startsWith('/works');
const atStory = path.startsWith('/story');
const atGoal = path.startsWith('/goal');
const atHobby = path.startsWith('/hobby');
const atContact = path.startsWith('/contact');
---
<header style="position:sticky;top:0;z-index:50;background:rgba(255,253,245,.93);backdrop-filter:blur(9px);border-bottom:1px solid rgba(21,21,21,.12)">
<div class="u-container" style="padding:0 56px;height:66px;display:flex;align-items:center;justify-content:space-between">
<a href="/" style="display:flex;align-items:center;gap:11px;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.18em;font-weight:500;color:#151515;text-decoration:none;transition:color .3s ease" style-hover="color:#3B82C4"><span style="width:34px;height:34px;flex:none;border:1px solid rgba(21,21,21,.22);border-radius:50%;overflow:hidden;display:block"><img src="/images/profile/アイコン.jpg" alt="Kentaro Sugiura" class="c-011" /></span>KENTARO SUGIURA</a>
<nav data-desktop-nav="" aria-label="メインナビゲーション" style="display:flex;align-items:center;gap:34px;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.22em">
<a href="/profile/" class="c-016" style-hover="color:#3B82C4;transform:translateY(-2px)">PROFILE{atProfile && <span class="c-051"></span>}</a>
<div data-nav-dropdown="works" style="position:relative;padding:23px 0">
<a href="/works/" class="c-016" style-hover="color:#3B82C4;transform:translateY(-2px)">WORKS{atWorks && <span class="c-051"></span>}</a>
<div class="c-156" data-dropdown-panel>
<a href="/works/mobility/" class="c-004" style-hover="background:#FBF5DE;transform:translateX(3px)"><span class="c-003"><span class="c-027">モビリティ研究</span><span class="c-025">01 MOBILITY</span></span><span class="c-108"><svg width="13" height="13" class="c-003"><use href="#i-arrow"></use></svg></span></a>
<a href="/works/aiwork/" class="c-004" style-hover="background:#FBF5DE;transform:translateX(3px)"><span class="c-003"><span class="c-027">AI × 仕事</span><span class="c-025">02 AI x WORK</span></span><span class="c-108"><svg width="13" height="13" class="c-003"><use href="#i-arrow"></use></svg></span></a>
<a href="/works/education/" class="c-004" style-hover="background:#FBF5DE;transform:translateX(3px)"><span class="c-003"><span class="c-027">AI × 教育</span><span class="c-025">03 AI x EDUCATION</span></span><span class="c-108"><svg width="13" height="13" class="c-003"><use href="#i-arrow"></use></svg></span></a>
</div>
</div>
<a href="/story/" class="c-016" style-hover="color:#3B82C4;transform:translateY(-2px)">STORY{atStory && <span class="c-051"></span>}</a>
<a href="/goal/" class="c-016" style-hover="color:#3B82C4;transform:translateY(-2px)">GOAL{atGoal && <span class="c-051"></span>}</a>
<div data-nav-dropdown="hobby" style="position:relative;padding:23px 0">
<a href="/hobby/" class="c-016" style-hover="color:#3B82C4;transform:translateY(-2px)">HOBBY{atHobby && <span class="c-051"></span>}</a>
<div class="c-156" data-dropdown-panel>
<a href="/hobby/castles/" class="c-004" style-hover="background:#FBF5DE;transform:translateX(3px)"><span class="c-003"><span class="c-027">日本100名城めぐり</span><span class="c-025">CASTLES</span></span><span class="c-108"><svg width="13" height="13" class="c-003"><use href="#i-arrow"></use></svg></span></a>
<a href="/hobby/travel/" class="c-004" style-hover="background:#FBF5DE;transform:translateX(3px)"><span class="c-003"><span class="c-027">旅行</span><span class="c-025">TRAVEL</span></span><span class="c-108"><svg width="13" height="13" class="c-003"><use href="#i-arrow"></use></svg></span></a>
<a href="/hobby/baseball/" class="c-004" style-hover="background:#FBF5DE;transform:translateX(3px)"><span class="c-003"><span class="c-027">野球観戦</span><span class="c-025">BASEBALL</span></span><span class="c-108"><svg width="13" height="13" class="c-003"><use href="#i-arrow"></use></svg></span></a>
</div>
</div>
<a href="/contact/" class="c-016" style-hover="color:#3B82C4;transform:translateY(-2px)">CONTACT{atContact && <span class="c-051"></span>}</a>
</nav>
<!-- モバイル用ハンバーガーボタン。デスクトップでは display:none（インラインで初期非表示）、
     ≤760px のみ responsive-patch の CSS で表示する。開閉はクライアントJS(nav-menu.js)が担当。 -->
<button data-hamburger aria-label="メニューを開閉する" aria-expanded="false" style="display:none;align-items:center;justify-content:center;width:44px;height:44px;margin-right:-10px;padding:0;background:none;border:none;color:#151515;cursor:pointer;-webkit-tap-highlight-color:transparent">
<svg data-icon-close width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true" hidden><path d="M6 6l12 12M18 6L6 18"></path></svg>
<svg data-icon-open width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M3.5 7h17M3.5 12h17M3.5 17h17"></path></svg>
</button>
</div>
<div style="height:2px;background:rgba(21,21,21,.06)"><div data-progress-bar style="height:2px;width:0%;background:linear-gradient(90deg,#3B82C4,#D9B979)"></div></div>
<!-- モバイルメニュー本体。常にDOMには存在させ、hidden属性で開閉する
     （ハンバーガーが開いた時だけ表示。ヘッダー直下に絶対配置で降ろす）。 -->
<nav data-mobile-menu aria-label="メインナビゲーション" hidden style="position:absolute;left:0;right:0;top:100%;background:#FFFDF5;border-bottom:1px solid rgba(21,21,21,.14);box-shadow:0 26px 40px -26px rgba(21,21,21,.5)">
<a href="/profile/" class="c-014">{atProfile && <span class="c-055"></span>}<span class="c-043">PROFILE</span><span class="c-036" data-patch="mobile-nav-subtitle">プロフィール</span></a>
<a href="/works/" class="c-014">{atWorks && <span class="c-055"></span>}<span class="c-043">WORKS</span><span class="c-036" data-patch="mobile-nav-subtitle">活動・研究</span></a>
<a href="/story/" class="c-014">{atStory && <span class="c-055"></span>}<span class="c-043">STORY</span><span class="c-036" data-patch="mobile-nav-subtitle">これまでの歩み</span></a>
<a href="/goal/" class="c-014">{atGoal && <span class="c-055"></span>}<span class="c-043">GOAL</span><span class="c-036" data-patch="mobile-nav-subtitle">目標・ビジョン</span></a>
<a href="/hobby/" class="c-014">{atHobby && <span class="c-055"></span>}<span class="c-043">HOBBY</span><span class="c-036" data-patch="mobile-nav-subtitle">趣味</span></a>
<a href="/contact/" class="c-014">{atContact && <span class="c-055"></span>}<span class="c-043">CONTACT</span><span class="c-036" data-patch="mobile-nav-subtitle">お問い合わせ</span></a>
</nav>
</header>

<!-- モバイルメニュー展開中の背景スクリム。ヘッダー直下〜画面下を覆い、タップでメニューを閉じる。 -->
<div data-menu-scrim aria-hidden="true" hidden style="position:fixed;left:0;right:0;top:68px;bottom:0;z-index:40;background:rgba(21,21,21,.3)"></div>

<style>
/* WORKS/HOBBYのデスクトップ用ドロップダウン。旧実装はJSのonMouseEnter/onMouseLeaveで
   DOM自体の出し入れ(sc-if)をしていたが、見た目上はホバーで出し引きするだけなので
   CSSのhoverだけで同じ挙動を再現できる（JS不要化）。 */
[data-dropdown-panel] { display: none !important; }
[data-nav-dropdown]:hover [data-dropdown-panel] { display: flex !important; }
</style>

<script>
import '../scripts/site-chrome.js';
</script>
