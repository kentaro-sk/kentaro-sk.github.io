{
  "name": "kentaro-sk-portfolio",
  "private": true,
  "description": "杉浦健太郎 パーソナルポートフォリオサイト用の検証ツール一式（サイト自体はビルド不要の素のHTML/CSS/JS）",
  "scripts": {
    "check:html": "html-validate index.html \"pages/**/*.html\"",
    "check:links": "linkinator index.html --recurse --skip %7B%7B",
    "check:css": "stylelint \"css/**/*.css\"",
    "check:images": "node scripts/check-image-sizes.mjs",
    "check:a11y": "node scripts/check-accessibility.mjs",
    "check:lighthouse": "lhci autorun --config=lighthouserc.json",
    "check": "npm run check:html && npm run check:links && npm run check:css && npm run check:images && npm run check:a11y"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "html-validate": "^11.16.0",
    "linkinator": "^8.1.0",
    "pa11y": "^10.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended": "^18.0.0"
  }
}
